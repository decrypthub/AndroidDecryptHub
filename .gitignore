# Build outputs
build/
out/
*.o
*.so.debug
*.apk
*.aab
*.dex.out
.cxx/

# Native / CMake
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# Gradle / Android
.gradle/
.kotlin/
local.properties
*.iml

# Node / Web
node_modules/
dist/
.vite/

# Rust (if daemon uses it)
target/

# Captured artifacts / runtime data (never commit target data)
captures/
dumps/
*.dexdump
*.trace
adhd-data/
*.sqlite
*.sqlite-*

# Scratch analysis scripts that must live under daemon/ to resolve capstone-wasm. Three of these were
# swept into a commit by `git add -A`; the rule keeps that from happening again.
daemon/tmp_*.mjs

# Third-party checkouts (use submodules)
agent/third_party/*/
!agent/third_party/.gitkeep

# Reference clone (kept local only)
.ref/

# Local tool cache (portable node etc.) — not source, machine-specific paths
.tools/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Staged agent build artifact (produced by tools/build_agent.sh)
sandbox-app/app/src/main/jniLibs/*/*.so

# Per-host agent build tree. tools/build_agent.sh refuses to reuse agent/build/ when it was made on a
# different host (a CMake cache is not portable) and builds into agent/build-<host>/ instead — which
# `build/` above does not match, so it showed up as untracked on Windows.
agent/build-*/

# Zygisk ndk-build intermediates (zip under dist/ is build output — also ignored via dist/)
injector/zygisk/libs/
injector/zygisk/obj/
injector/zygisk/.stage/

# harness/session state
.claude/
